---
import ArrowIcon from './ArrowIcon.astro';

export interface Props {
  /** Card title. Required. */
  title: string;
  /** Destination of the card. Required. */
  href: string;
  /** Optional summary, clamped to 3 lines. Omit and the block is not rendered. */
  summary?: string;
  /** Optional, already formatted for display (e.g. "2024 年 05 月 01 日"). */
  date?: string;
  category?: string;
  categoryHref?: string;
  tags?: { label: string; href: string }[];
  /** Optional square cover thumbnail shown on the card's right edge. */
  cover?: string;
}

const { title, href, summary, date, category, categoryHref, tags = [], cover } = Astro.props;

/* The meta line is "date · category · #tags". Built as a list so the separator
   is emitted only *between* two rendered parts: a card with a date alone has
   no dangling dot, and a card with no meta at all renders no paragraph. */
const meta: { value: string; href?: string }[] = [];
if (date) meta.push({ value: date });
if (category) meta.push({ value: category, href: categoryHref });
const hasMeta = meta.length > 0 || tags.length > 0;
---

<article class="card" data-post-link={href} tabindex="0">
  <span class="card-sheet card-sheet--fill" aria-hidden="true"></span>
  <span class="card-sheet card-sheet--frame" aria-hidden="true"></span>

  <div class="card-body">
    <div class="card-text">
    <h3 class="card-title">
      <a class="card-link" href={href}>
        <span class="card-title-text">{title}</span>
        <ArrowIcon />
      </a>
    </h3>

    {summary && <p class="card-summary">{summary}</p>}

    {
      hasMeta && (
        <p class="card-meta">
          {meta.map((part, i) => (
            <>
              {i > 0 && <span class="card-sep" aria-hidden="true"> · </span>}
              {part.href ? <a class="link-dashed" href={part.href}>{part.value}</a> : <span>{part.value}</span>}
            </>
          ))}
          {meta.length > 0 && tags.length > 0 && (
            <span class="card-sep" aria-hidden="true"> · </span>
          )}
          {tags.map((tag, i) => (
            <>
              {i > 0 && <span class="card-sep" aria-hidden="true"> </span>}
              <a class="card-tag link-dashed" href={tag.href}>#{tag.label}</a>
            </>
          ))}
        </p>
      )
    }
    </div>
    {/* Decorative: the title link already names the card. After the text in
        the DOM so the thumbnail sits on the card's right edge. */}
    {cover && <img class="card-cover" src={cover} alt="" aria-hidden="true" loading="lazy" />}
  </div>
</article>

<style>
  /* The card shell — the outer box, both dashed sheets, the content layer,
     the hover/focus displacement and the reduced-motion guard — lives in
     global.css (R4 contract §3.1). Those class names must stay global because
     ArrowIcon.astro selects against them with :global(.card) .arrow.
     What remains here is the card's typography, its links and its focus rings. */

  /* The card itself carries tabindex="0" for parity with the reference; its
     ring must be visible, and the inner anchor keeps its own. */
  .card:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  /* With a cover the body splits: text left, a 132px square thumbnail right.
     Without one, .card-text is a plain block and the card spans full width. */
  .card-body {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .card-text {
    min-width: 0;
    flex: 1;
  }

  .card-cover {
    flex: none;
    width: 132px;
    height: 132px;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 1rem; /* 16px, softer than the card's 24px */
  }

  @media (max-width: 40rem) {
    .card-cover {
      width: 96px;
      height: 96px;
    }
  }

  .card-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  @media (min-width: 768px) {
    .card-title {
      font-size: 24px;
    }
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg);
    text-decoration: none;
  }

  .card:hover .card-link,
  .card:focus-visible .card-link,
  .card:has(.card-link:focus-visible) .card-link {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .card-summary {
    margin: 0.6rem 0 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .card-meta {
    margin: 0.75rem 0 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  /* The dashed underline comes from the global .link-dashed class on the
     anchors themselves (R4 contract §3.3); only the colour states are local. */
  .card-meta a {
    color: var(--meta);
  }

  .card-meta a:hover {
    color: var(--fg);
  }

  /* The title link is stretched over the whole card (global.css `.card-link::after`),
     so the meta row has to sit above that overlay or the tag chips would be
     unclickable. Raising the row, not each chip, keeps one stacking decision. */
  .card-meta {
    position: relative;
    z-index: 2;
  }
</style>
