---
import type { Lang } from '../lib/site';

interface ProjectLinks {
  repo?: string;
  release?: string;
  demo?: string;
}

interface Props {
  lang: Lang;
  title: string;
  tagline: string;
  status?: string;
  stack?: string[];
  links?: ProjectLinks;
  /** Render the frame only, without the metadata panel (used on the detail page). */
  compact?: boolean;
}

const { lang, title, tagline, status, stack = [], links = {}, compact = false } = Astro.props;

const linkLabels: Record<keyof ProjectLinks, Record<Lang, string>> = {
  repo: { zh: '源码', en: 'Source' },
  release: { zh: '下载', en: 'Download' },
  demo: { zh: '演示', en: 'Demo' },
};

const entries = (Object.keys(linkLabels) as (keyof ProjectLinks)[])
  .filter((k) => links[k])
  .map((k) => ({ key: k, href: links[k] as string, label: linkLabels[k][lang] }));
---

<figure class="paste-window">
  <div class="chrome">
    <span class="lights" aria-hidden="true">
      <i class="l-close"></i>
      <i class="l-min"></i>
      <i class="l-zoom"></i>
    </span>
    <span class="chrome-title">{title}</span>
    {status && <span class="chrome-status">{status}</span>}
  </div>

  <div class="body">
    <p class="app-tagline">{tagline}</p>

    {
      !compact && stack.length > 0 && (
        <div class="app-section">
          <h2 class="app-label">{lang === 'zh' ? '技术栈' : 'Stack'}</h2>
          <ul class="app-stack">
            {stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      !compact && entries.length > 0 && (
        <div class="app-section">
          <h2 class="app-label">{lang === 'zh' ? '获取' : 'Get it'}</h2>
          <ul class="app-links">
            {entries.map((e) => (
              <li>
                <a href={e.href} rel="noreferrer">
                  {e.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</figure>

<style>
  /* The one place this site raises its voice: a real macOS window, drawn in
     CSS, because the subject *is* a native macOS app. Every other surface on
     the site is flat paper. */
  .paste-window {
    margin: 0;
    background: var(--paper);
    border: 1px solid var(--frame);
    border-radius: 10px; /* the only radius on the site — windows are round */
    overflow: hidden;
    box-shadow: 0 1px 0 var(--rule), 0 12px 32px -18px rgba(22, 24, 26, 0.45);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    background: var(--frame);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .lights {
    display: flex;
    gap: 0.4rem;
    flex: none;
  }

  .lights i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    display: block;
  }

  .l-close {
    background: #ff5f57;
  }

  .l-min {
    background: #febc2e;
  }

  .l-zoom {
    background: #28c840;
  }

  .chrome-title {
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .chrome-status {
    margin-left: auto;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .body {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .app-tagline {
    text-indent: 0;
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .app-section {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .app-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.02em;
    margin: 0 0 0.6rem;
    color: var(--ink-faint);
  }

  .app-stack,
  .app-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .app-stack li {
    border: 1px solid var(--rule);
    padding: 0.1rem 0.5rem;
  }

  .app-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--seal);
  }

  @media (max-width: 30rem) {
    .chrome-status {
      display: none;
    }
  }
</style>
