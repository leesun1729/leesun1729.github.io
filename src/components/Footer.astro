---
import { SITE, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/* "已运行 N 天" — days since SITE.startYear began. Computed at build time, so
   it advances whenever the site is rebuilt (the reference does the same). */
const start = new Date(SITE.startYear, 0, 1);
const days = Math.max(1, Math.floor((Date.now() - start.getTime()) / 86_400_000));
const year = new Date().getFullYear();

const L = {
  zh: {
    days: `已运行 ${days} 天`,
    rights: `© ${year} ${SITE.author}，保留所有权利`,
  },
  en: {
    days: `Running for ${days} days`,
    rights: `© ${year} ${SITE.author}. All rights reserved.`,
  },
}[lang];
---

<footer class="site-foot">
  <div class="wrap foot-inner">
    <a class="foot-brand" href={lang === 'zh' ? '/' : '/en/'}>
      {/* Same mark, size and shape as the navbar brand icon. */}
      <img
        class="foot-mark"
        src="/favicons/favicon-64x64.png"
        alt=""
        width="30"
        height="30"
        loading="lazy"
        decoding="async"
      />
      <span>Hi, {SITE.author}</span>
    </a>

    <p class="foot-line">{L.days}</p>
    <p class="foot-line">{L.rights}</p>
  </div>
</footer>

<style>
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-block: 2rem 3rem;
  }

  /* The reference footer is one centred row of items separated by vertical
     rules; it collapses to a centred column on narrow screens. */
  .foot-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
  }

  @media (min-width: 40rem) {
    .foot-inner {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 1rem;
    }
  }

  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .foot-mark {
    width: 30px;
    height: 30px;
    display: block;
    border-radius: 50%;
  }

  .foot-line {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  /* The vertical rules between items, from the reference's sm:border-l. */
  @media (min-width: 40rem) {
    .foot-line {
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
