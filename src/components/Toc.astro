---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  label: string;
}

const { headings, label } = Astro.props;
/* Only h2/h3 reach the rail; h4 would crowd it and rarely carries a section. */
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label={label}>
      <ol>
        {items.map((h) => (
          <li class={h.depth === 3 ? 'is-sub' : undefined}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    font-size: 12px;
    line-height: 1.6;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px dashed var(--line);
  }

  .toc li {
    padding-left: 0.75rem;
    margin-left: -1px;
  }

  .toc li + li {
    margin-top: 0.4rem;
  }

  .toc li.is-sub {
    padding-left: 1.5rem;
    color: var(--muted);
  }

  .toc a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  @media (max-width: 60rem) {
    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      border-left: 0;
    }

    .toc li,
    .toc li.is-sub {
      padding-left: 0;
      margin-left: 0;
    }
  }
</style>
