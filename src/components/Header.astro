---
import { SITE, NAV, localeTag, counterpart, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const alt = counterpart(pathname);
const home = lang === 'zh' ? '/' : '/en/';
const items = NAV[lang];

const isActive = (href: string) =>
  href === home ? pathname === home : pathname.startsWith(href);

const altLabel = alt.lang === 'en' ? 'English' : '中文';
const altShort = alt.lang === 'en' ? 'EN' : '中';
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href={home}>{SITE.name[lang]}</a>

    <nav class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main'}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="lang-switch"
      href={alt.href}
      hreflang={localeTag[alt.lang]}
      lang={localeTag[alt.lang]}
      title={alt.exact ? altLabel : `${altLabel} (${SITE.name[alt.lang]})`}
    >
      <span aria-hidden="true">{altShort}</span>
      <span class="sr-only">{altLabel}</span>
    </a>
  </div>
</header>

<style>
  /* Spec §3: 80px tall, absolutely positioned (NOT sticky), no background —
     the page ground shows straight through. */
  .site-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    min-height: var(--header-h);
    background: transparent;
  }

  .head-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .brand {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
    color: var(--fg);
    text-decoration: none;
    margin-right: auto;
  }

  .brand:hover {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  /* Spec §2: nav links carry 12px inline padding. */
  .site-nav a {
    display: inline-block;
    padding: 0.25rem 12px;
    color: var(--meta);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .site-nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 700;
  }

  .lang-switch {
    flex: none;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta);
    text-decoration: none;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .lang-switch:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  /* Below 40rem the five-item nav cannot share one 80px row with the brand,
     so it drops to a second row; both rows still fit inside --header-h. */
  @media (max-width: 40rem) {
    .head-inner {
      flex-wrap: wrap;
      align-content: center;
      row-gap: 0.25rem;
      column-gap: 0.75rem;
    }

    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav ul {
      gap: 0;
      font-size: 13px;
    }

    .site-nav a {
      padding-inline: 10px;
    }
  }
</style>
