---
/**
 * The inline arrow that trails a card title (spec §5).
 * No props. Decorative only — the accessible name comes from the link text.
 */
---

<svg
  class="arrow"
  viewBox="0 0 13 15"
  width="10"
  height="10"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <g transform="translate(0.666667, 2.333333)">
    <polyline points="5.33333333 0 10.8333333 5.5 5.33333333 11"></polyline>
    <line x1="10.8333333" y1="5.5" x2="0.833333333" y2="5.16666667"></line>
  </g>
</svg>

<style>
  .arrow {
    flex: none;
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
  }

  /* Inside a card the arrow rests one step left and invisible, then slides to
     its final position and fades in when the card is hovered or focused.
     Outside a card it stays at rest, visible and in place. */
  :global(.card) .arrow {
    opacity: 0;
    transform: translateX(-0.25rem);
  }

  :global(.card:hover) .arrow,
  :global(.card:focus-visible) .arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
