---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import { formatDate, isoDate, cleanTags, type Lang } from '../lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  pathname: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  summary?: string;
  headings?: MarkdownHeading[];
  /** Reading time in minutes, computed by the caller from the raw body. */
  minutes?: number;
  /** Position within the articles collection, e.g. "03 / 06". */
  index?: string;
}

const {
  lang,
  title,
  description,
  pathname,
  date,
  updated,
  tags = [],
  summary,
  headings = [],
  minutes,
  index,
} = Astro.props;

const tagList = cleanTags(tags);
const railLabel = lang === 'zh' ? '本页目录' : 'On this page';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description ?? summary}
  pathname={pathname}
  ogType="article"
  publishedTime={date}
>
  <article class="sheet note">
    <!-- Right rail removed: user requested left-only navigation -->
    
    <aside class="rail">
      <ol>
        {index && <li>{index}</li>}
        <li><time datetime={isoDate(date)}>{formatDate(date, lang)}</time></li>
        {updated && (
          <li>
            {lang === 'zh' ? '修订 ' : 'rev. '}
            <time datetime={isoDate(updated)}>{formatDate(updated, lang)}</time>
          </li>
        )}
        {minutes && <li>{lang === 'zh' ? `约 ${minutes} 分钟` : `${minutes} min read`}</li>}
      </ol>

      {
        tagList.length > 0 && (
          <ul class="tags rail-tags">
            {tagList.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }

      <Toc headings={headings} label={railLabel} />
    </aside>

    <!-- 2) Add categories/tags to article list pages via inline styles in ArticleSearch, 
         but we also need to import the component with props on /articles/ -->
    <div class="prose" data-pagefind-body>
      <header class="note-head">
        <h1>{title}</h1>
        {summary && <p class="lede">{summary}</p>}
      </header>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .note-head {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  /* .note-head h1 sets no font-size: the single h1 ramp lives in global.css
     (R4 contract §2), so note titles match every other page-level h1. */
  .note-head h1 {
    margin-bottom: 0.5rem;
  }

  /* The lede is a summary, not running prose. `.prose > p` carries the 2em
     first-line indent and this <p> sits inside .note-head rather than under
     .prose, so no indent reaches it; the declaration below is the explicit
     guard that keeps it so. Type and colour come from the global .lede
     (R4 contract §3.2). */
  .lede {
    text-indent: 0;
    margin: 0;
    line-height: 1.7;
  }

  .rail-tags {
    margin-top: 1.5rem;
    flex-direction: column;
    gap: 0.3rem;
  }

  .rail :global(.toc) {
    margin-top: 1.5rem;
  }

  @media (max-width: 60rem) {
    .rail-tags {
      margin-top: 0;
      flex-direction: row;
      gap: 0.25rem 1.25rem;
    }

    .rail :global(.toc) {
      margin-top: 0;
      width: 100%;
    }
  }
</style>
