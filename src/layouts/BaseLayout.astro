---
/* fonts.css holds the generated @font-face rules (7 faces, unicode-range
   slices). It must be loaded before global.css so the families global.css
   names in --font-serif are already declared when the cascade resolves. */
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, localeTag, counterpart, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path of this page, used for canonical + hreflang + nav state. */
  pathname: string;
  /** Omit the site name suffix (used by the home page, which leads with it). */
  bareTitle?: boolean;
  /** og:type — 'article' for note and project detail pages. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  lang,
  title,
  description = SITE.description[lang],
  pathname,
  bareTitle = false,
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} · ${SITE.name[lang]}`;
const canonical = new URL(pathname, SITE.url).href;
const alt = counterpart(pathname);
const altUrl = new URL(alt.href, SITE.url).href;
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="alternate" hreflang={localeTag[lang]} href={canonical} />
          <link rel="alternate" hreflang={localeTag[alt.lang]} href={altUrl} />
          <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTag[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta id="theme-color-light" name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta id="theme-color-dark" name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    {/* Site icons, from public/favicons/ (migrated there from the repo root).
        The .ico first so older browsers stop there, then the PNG ladder. */}
    <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicons/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />

    {/* Theme engine. `is:inline` keeps this in <head> as a plain blocking
        script — no bundle, no defer — so `data-theme` and the theme-color
        metas are settled before the first paint. Three states:
        'system' (default) | 'light' | 'dark', persisted under localStorage
        key `theme`. window.__theme is the single source of truth the toggle
        reads and writes. */}
    <script is:inline>
      (function () {
        var KEY = 'theme';
        var root = document.documentElement;
        var CHOICES = ['system', 'light', 'dark'];

        function read() {
          try {
            var v = localStorage.getItem(KEY);
            return CHOICES.indexOf(v) === -1 ? 'system' : v;
          } catch (e) {
            return 'system';
          }
        }

        function syncMeta(choice) {
          var light = document.getElementById('theme-color-light');
          var dark = document.getElementById('theme-color-dark');
          if (!light || !dark) return;
          if (choice === 'light') {
            light.removeAttribute('media');
            dark.setAttribute('media', 'not all');
          } else if (choice === 'dark') {
            dark.removeAttribute('media');
            light.setAttribute('media', 'not all');
          } else {
            light.setAttribute('media', '(prefers-color-scheme: light)');
            dark.setAttribute('media', '(prefers-color-scheme: dark)');
          }
        }

        function apply(choice) {
          root.setAttribute('data-theme', choice);
          syncMeta(choice);
        }

        apply(read());

        window.__theme = {
          choices: CHOICES,
          get: function () {
            return root.getAttribute('data-theme') || 'system';
          },
          set: function (next) {
            if (CHOICES.indexOf(next) === -1) next = 'system';
            try {
              if (next === 'system') localStorage.removeItem(KEY);
              else localStorage.setItem(KEY, next);
            } catch (e) {
              /* storage unavailable — the choice still applies for this page */
            }
            apply(next);
          },
        };
      })();
    </script>

    <script>
      import '../scripts/han.ts';
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <Header lang={lang} pathname={pathname} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  /* Off-screen until focused, then parked in the top-left corner. It reads as
     a small piece of paper: page ground, a hairline frame — the same language
     as the cards, and legible on either ground. */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    /* Above the sticky header (100): the header is sticky now, so a focused
       skip link buried under it would be invisible to keyboard users. */
    z-index: 101;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.5;
    text-decoration: none;
  }

  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>
