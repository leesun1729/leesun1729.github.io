---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, categoryLabel, formatDate, cleanTags } from '../../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

/* Articles are `<slug>/zh.md` and `<slug>/en.md`, so this locale's entries are
   the `/zh` ones and the URL slug is the directory name. */
const slugOf = (id: string) => id.split('/')[0];

/* Chinese category index: `/articles/category/<key>/`.
   The English mirror lives at src/pages/en/articles/category/[category].astro
   and must stay in step. */
export async function getStaticPaths() {
  /* getStaticPaths is hoisted to module scope, above the frontmatter, so it
     cannot reach the `asDate` helper defined there — dates are already Date
     objects, so compare them directly. */
  const all = (await getCollection('articles', ({ data }) => !data.draft))
    .filter((a) => a.id.endsWith('/zh'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  /* One page per category that actually carries articles. A key with no
     entries would be an empty page, so it is dropped rather than published. */
  return CATEGORIES.map((c) => ({
    params: { category: c.key },
    props: { key: c.key, notes: all.filter((a) => a.data.category === c.key) },
  })).filter((p) => p.props.notes.length > 0);
}

const { key, notes } = Astro.props;

const label = categoryLabel(key, 'zh');
const total = notes.length;
const pathname = `/articles/category/${key}/`;

/* Tag chips link to the real per-tag routes built by src/pages/tags/[tag].astro. */
const tagLinks = (tags: string[] | undefined) =>
  cleanTags(tags).map((t) => ({ label: t, href: `/tags/${encodeURIComponent(t)}/` }));
---

<BaseLayout
  lang="zh"
  title={label}
  description={`${total} 篇关于${label}的文章`}
  pathname={pathname}
>
  <div class="container">
    <header class="page-head">
      <h1>{label}</h1>
      <p class="lede">
        {total} 篇关于{label}的文章
      </p>
      <p class="page-meta">
        {total} 篇 · <a class="link-dashed" href="/articles/">全部文章</a>
      </p>
    </header>

    <div class="card-stack">
      {
        notes.map((n) => (
          <PostCard
            title={n.data.title}
            href={`/articles/${slugOf(n.id)}/`}
            summary={n.data.summary}
            date={formatDate(asDate(n.data.date), 'zh')}
            category={categoryLabel(n.data.category, 'zh')}
            categoryHref={`/articles/category/${key}/`}
            tags={tagLinks(n.data.tags)}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
