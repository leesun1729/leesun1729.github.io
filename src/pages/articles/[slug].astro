---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

/* Chinese article detail pages: `/articles/<slug>/`.
   Entries are `<slug>/zh.md`, so the URL slug is the directory name and only
   the `/zh` half of each pair is routed here. The English mirror lives at
   src/pages/en/articles/[slug].astro and must stay in step. */
export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const zh = all
    .filter((a) => a.id.endsWith('/zh'))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return zh.map((entry) => {
    const position = zh.findIndex((n) => n.id === entry.id) + 1;
    return {
      params: { slug: entry.id.split('/')[0] },
      props: {
        entry,
        index: `${String(position).padStart(2, '0')} / ${String(zh.length).padStart(2, '0')}`,
      },
    };
  });
}

const { entry, index } = Astro.props;
const { Content, headings } = await render(entry);

/* ~350 CJK glyphs/min is a reasonable pace for technical Chinese prose. */
const plain = entry.body ?? '';
const minutes = Math.max(1, Math.round(plain.replace(/\s+/g, '').length / 350));
---

<ArticleLayout
  lang="zh"
  title={entry.data.title}
  description={entry.data.summary}
  pathname={`/articles/${entry.id.split('/')[0]}/`}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  summary={entry.data.summary}
  headings={headings}
  minutes={minutes}
  index={index}
>
  <Content />
</ArticleLayout>
