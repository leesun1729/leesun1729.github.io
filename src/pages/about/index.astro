---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';

/* 自我介绍：一行一个特征，短句，不写完整句子（参考站点的体例）。 */
const traits = ['攻读硕士 ing', '现居中国', '王者、国漫爱好者', '喜欢旅游、尝试新鲜事物'];

/* 目录项与页面上的 h2 一一对应，id 必须和 <h2 id="…"> 完全一致。 */
const sections = [
  { id: 'footprints', label: '足迹' },
  { id: 'anime', label: '动漫' },
  { id: 'contact', label: '联系' },
];

/* 联系方式的平台标签 + 真实链接，数据来自 src/lib/site.ts，不新增账号。 */
const contacts = [
  { label: '邮箱', href: `mailto:${SITE.email}`, text: SITE.email, external: false },
  { label: 'GitHub', href: SITE.github, text: 'github.com/leesun1729', external: true },
];

/* 动漫区占位槽位：业主之后把内容填进去即可。 */
const animeSlots = Array.from({ length: 6 });
---

<BaseLayout
  lang="zh"
  title="关于"
  description="leesun 的关于页：自我介绍、足迹、动漫与联系方式。"
  pathname="/about/"
>
  <div class="container">
    <header class="page-head">
      <h1>关于</h1>
    </header>

    <details class="toc">
      <summary>
        <span class="toc-title">目录</span>
        <span class="toc-hint" aria-hidden="true">
          <span class="hint-expand">展开</span>
          <span class="hint-collapse">收起</span>
        </span>
      </summary>
      <nav class="toc-nav" aria-label="目录">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a class="link-dashed" href={`#${s.id}`}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <article class="prose">
      <ul class="traits">
        {traits.map((t) => <li>{t}</li>)}
      </ul>

      <h2 id="footprints">足迹</h2>



      <iframe
        class="vagula-map"
        src="/VagulaMap/index.html"
        title="旅行足迹地图"
        loading="lazy"
        allowfullscreen
      ></iframe>

      <h2 id="anime">动漫</h2>

      <p>国漫荣光</p>

      <!-- 动漫条目加在这里：把每个 <li> 里的「＋」换成「作品名（年份）· 一句短评」；
           不够用就复制一个 <li>，用不到就删掉多余的 <li>。 -->
      <ul class="anime-grid" aria-label="动漫占位，待补充">
        {
          animeSlots.map(() => (
            <li class="anime-slot">
              <span aria-hidden="true">＋</span>
            </li>
          ))
        }
      </ul>

      <h2 id="contact">联系</h2>

      <ul class="contacts">
        {
          contacts.map((c) => (
            <li>
              <span class="contact-label">{c.label}</span>
              <a href={c.href} rel={c.external ? 'me noreferrer' : undefined}>
                {c.text}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</BaseLayout>

<style>
  /* Page-local blocks only. .container / .page-head are defined once in
     global.css (R4 contract §3.2); a local copy would outrank them through
     [data-astro-cid-*]. */

  /* --- 目录：原生 <details>，无 JS，键盘可达 ---------------------------- */

  /* Same dashed language as .card / .map / .empty-state: 1px dashed var(--line). */
  .toc {
    border: 1px dashed var(--line);
    border-radius: 1rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .toc > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    color: var(--meta);
    list-style: none;
  }

  .toc > summary::-webkit-details-marker {
    display: none;
  }

  .toc > summary::marker {
    content: '';
  }

  .toc > summary:hover {
    color: var(--fg);
  }

  /* Focus ring: the single global :focus-visible rule (contract §4.4). */

  .toc[open] > summary {
    border-bottom: 1px dashed var(--line);
  }

  .hint-collapse {
    display: none;
  }

  .toc[open] .hint-expand {
    display: none;
  }

  .toc[open] .hint-collapse {
    display: inline;
  }

  .toc-nav {
    padding: 0.7rem 1rem 0.8rem;
  }

  .toc-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  /* The jump links carry the global .link-dashed class (R4 contract §3.3);
     only the colour state stays local. */
  .toc-nav a {
    color: inherit;
  }

  .toc-nav a:hover {
    color: var(--fg);
  }

  /* --- 自我介绍：短句列表，不缩进、无首行缩进 -------------------------- */

  .traits {
    font-size: var(--step-1);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .traits li {
    margin-bottom: 0.15em;
  }

  /* --- 足迹：业主引入的 VagulaMap（iframe 自包含组件） ------------------- */

  .vagula-map {
    display: block;
    width: 100%;
    height: 600px;
    border: 1px dashed var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg);
  }

  @media (max-width: 40rem) {
    .vagula-map {
      height: 420px;
    }
  }

  /* --- 动漫：占位网格，等业主填内容 ----------------------------------- */

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.2em 0 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .anime-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .anime-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4.5rem;
    margin: 0;
    border: 1px dashed var(--line);
    border-radius: 1rem; /* same corner language as .card / .map / .empty-state */
    /* The "＋" is a glyph, so it takes a text token. --line-strong is a border
       token and must never colour text (R4 contract §0), and its light value
       sits under the 3:1 floor for a non-body glyph. --muted matches the
       neighbouring "to be filled in" note (.map-sub) and clears 4.5:1. */
    color: var(--muted);
    font-size: var(--step-1);
  }

  /* --- 联系：平台标签 + 真实链接 --------------------------------------- */

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contacts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    margin: 0;
    border-bottom: 1px dashed var(--line);
  }

  .contact-label {
    min-width: 5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--meta);
  }

  h2 {
    scroll-margin-top: 1.5rem;
  }
</style>
