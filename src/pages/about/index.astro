---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ANIME, animePoster } from '../../lib/anime';
import { SITE } from '../../lib/site';

/* 自我介绍：一行一个特征，短句，不写完整句子（参考站点的体例）。 */
const traits = ['攻读硕士 ing', '现居中国', '王者、国漫爱好者', '喜欢旅游、尝试新鲜事物'];

/* 目录项与页面上的 h2 一一对应，id 必须和 <h2 id="…"> 完全一致。 */
const sections = [
  { id: 'footprints', label: '足迹' },
  { id: 'anime', label: '动漫' },
  { id: 'contact', label: '联系' },
];

/* 联系方式的平台标签 + 真实链接，数据来自 src/lib/site.ts，不新增账号。 */
const contacts = [
  { label: '邮箱', href: `mailto:${SITE.email}`, text: SITE.email, external: false },
  { label: 'GitHub', href: SITE.github, text: 'github.com/leesun1729', external: true },
];

/* 片单数据与海报探测在 src/lib/anime.ts，中英两页共用同一份。 */
---

<BaseLayout
  lang="zh"
  title="关于"
  description="leesun 的关于页：自我介绍、足迹、动漫与联系方式。"
  pathname="/about/"
>
  <div class="container">
    <header class="page-head">
      <h1>关于</h1>
    </header>

    <details class="toc">
      <summary>
        <span class="toc-title">目录</span>
        <span class="toc-hint" aria-hidden="true">
          <span class="hint-expand">展开</span>
          <span class="hint-collapse">收起</span>
        </span>
      </summary>
      <nav class="toc-nav" aria-label="目录">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a class="link-dashed" href={`#${s.id}`}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <article class="prose">
      <ul class="traits">
        {traits.map((t) => <li>{t}</li>)}
      </ul>

      <h2 id="footprints">足迹</h2>



      <iframe
        class="vagula-map"
        src="/VagulaMap/index.html"
        title="旅行足迹地图"
        loading="lazy"
        allowfullscreen
      ></iframe>

      <h2 id="anime">动漫</h2>

      <p>国漫荣光</p>

      <!-- 只显示有封面的条目：把海报按片名放进 public/images/anime/（例如
           剑来.jpg），重新构建即出现；没有封面的条目不再渲染。 -->
      <ul class="anime-grid" aria-label="国漫片单">
        {
          ANIME.map((a) => ({ a, poster: animePoster(a) }))
            .filter((x) => x.poster)
            .map(({ a, poster }) => (
              <li class="anime-item">
                <a class="anime-card" href={a.href} rel="noreferrer" target="_blank">
                  <img
                    class="anime-poster"
                    src={poster}
                    alt={`${a.title}海报`}
                    width="300"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="anime-meta">
                    <span class="anime-title">{a.title}</span>
                    <span class="anime-sub">
                      {a.year} · {a.platform}{a.film && ' · 院线'}
                    </span>
                    <span class="anime-note">{a.note.zh}</span>
                  </span>
                </a>
              </li>
            ))
        }
      </ul>

      <h2 id="contact">联系</h2>

      <ul class="contacts">
        {
          contacts.map((c) => (
            <li>
              <span class="contact-label">{c.label}</span>
              <a href={c.href} rel={c.external ? 'me noreferrer' : undefined}>
                {c.text}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</BaseLayout>

<style>
  /* Page-local blocks only. .container / .page-head are defined once in
     global.css (R4 contract §3.2); a local copy would outrank them through
     [data-astro-cid-*]. */

  /* --- 目录：原生 <details>，无 JS，键盘可达 ---------------------------- */

  /* Same dashed language as .card / .map / .empty-state: 1px dashed var(--line). */
  .toc {
    border: 1px dashed var(--line);
    border-radius: 1rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .toc > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    color: var(--meta);
    list-style: none;
  }

  .toc > summary::-webkit-details-marker {
    display: none;
  }

  .toc > summary::marker {
    content: '';
  }

  .toc > summary:hover {
    color: var(--fg);
  }

  /* Focus ring: the single global :focus-visible rule (contract §4.4). */

  .toc[open] > summary {
    border-bottom: 1px dashed var(--line);
  }

  .hint-collapse {
    display: none;
  }

  .toc[open] .hint-expand {
    display: none;
  }

  .toc[open] .hint-collapse {
    display: inline;
  }

  .toc-nav {
    padding: 0.7rem 1rem 0.8rem;
  }

  .toc-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  /* The jump links carry the global .link-dashed class (R4 contract §3.3);
     only the colour state stays local. */
  .toc-nav a {
    color: inherit;
  }

  .toc-nav a:hover {
    color: var(--fg);
  }

  /* --- 自我介绍：短句列表，不缩进、无首行缩进 -------------------------- */

  .traits {
    font-size: var(--step-1);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .traits li {
    margin-bottom: 0.15em;
  }

  /* --- 足迹：业主引入的 VagulaMap（iframe 自包含组件） ------------------- */

  .vagula-map {
    display: block;
    width: 100%;
    height: 600px;
    border: 1px dashed var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg);
  }

  @media (max-width: 40rem) {
    .vagula-map {
      height: 420px;
    }
  }

  /* --- 联系：平台标签 + 真实链接 --------------------------------------- */

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contacts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    margin: 0;
    border-bottom: 1px dashed var(--line);
  }

  .contact-label {
    min-width: 5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--meta);
  }

  /* The sticky header is 60px tall; 1.5rem let a jumped-to heading land under
     it. Match the offset the home page's list anchors already use. */
  h2 {
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
</style>
