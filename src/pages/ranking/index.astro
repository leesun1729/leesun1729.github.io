---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadRanking, labelFor, share } from '../../lib/ranking';
import { formatDate } from '../../lib/site';

const { entries, generatedAt, source, site } = loadRanking();
const max = entries.reduce((m, e) => Math.max(m, e.count), 0);
const hasData = entries.length > 0;
---

<BaseLayout
  lang="zh"
  title="榜单"
  description="站内页面浏览量排行，数据来自 GoatCounter。"
  pathname="/ranking/"
>
  <div class="container">
    <header class="page-head">
      <h1>榜单</h1>
      <p class="lede">按页面浏览量排序。数字来自 GoatCounter，不追踪个人身份。</p>
      <p class="page-meta">
        {hasData ? `${entries.length} 个页面` : '暂无数据'}
        {source && <span class="sep"> · </span>}
        {source && <span>{source}</span>}
        {generatedAt && <span class="sep"> · </span>}
        {generatedAt && (
          <time datetime={generatedAt.slice(0, 10)}>{formatDate(new Date(generatedAt), 'zh')}</time>
        )}
      </p>
    </header>

    {
      hasData ? (
        <ol class="rank-list">
          {entries.map((e, i) => (
            <li class="rank-row">
              <span class="rank-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="rank-body">
                <a class="rank-link" href={e.path}>
                  {labelFor(e)}
                </a>
                <span class="rank-bar" aria-hidden="true">
                  <span style={`width:${(share(e.count, max) * 100).toFixed(1)}%`} />
                </span>
              </span>
              <span class="rank-count">{e.count.toLocaleString('zh-CN')}</span>
            </li>
          ))}
        </ol>
      ) : (
        /* The shipped state: the pipeline has never produced a successful run,
           so the page explains itself instead of showing an empty table. */
        <div class="empty-state prose">
          <p class="empty-title">还没有可用的数据。</p>
          <p>
            榜单由 <code>scripts/fetch-ranking.mjs</code> 从 GoatCounter 拉取，结果写入
            <code>src/data/ranking.json</code>。目前这个文件里
            <code>entries</code> 为空数组，说明还没有一次成功的抓取——通常是
            <code>GOATCOUNTER_SITE</code> 或 <code>GOATCOUNTER_TOKEN</code> 还没配置。
          </p>
          <p>
            在此之前，可以先去<a href="/notes/">笔记</a>和<a href="/projects/">项目</a>看看。
          </p>
          {site && (
            <p class="empty-meta">
              数据源：<a href={site} rel="noreferrer">{site}</a>
            </p>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .page-head {
    padding-block: 28px;
  }

  .page-head h1 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 0 0 12px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .page-meta {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .rank-row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px dashed var(--line, #d4d4d4);
  }

  .rank-num {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted, #525252);
    font-variant-numeric: tabular-nums;
  }

  .rank-body {
    min-width: 0;
  }

  .rank-link {
    text-decoration: none;
  }

  /* Bar length is real data, not decoration: it is the count, scaled to the top row. */
  .rank-bar {
    display: block;
    height: 2px;
    background: var(--line, #d4d4d4);
    margin-top: 8px;
  }

  .rank-bar > span {
    display: block;
    height: 100%;
    background: var(--fg, #000);
  }

  .rank-count {
    font-size: 12px;
    font-weight: 500;
    color: var(--meta, #262626);
    font-variant-numeric: tabular-nums;
  }

  .empty-state {
    max-width: 40em;
    padding: 20px 24px;
    border: 1px dashed var(--line, #d4d4d4);
    border-radius: 1rem;
  }

  .empty-title {
    margin-top: 0;
    font-weight: 700;
    text-indent: 0;
  }

  .empty-state p {
    text-indent: 0;
  }

  .empty-state p:last-child {
    margin-bottom: 0;
  }

  .empty-meta {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .page-head h1 {
      font-size: 48px;
    }
  }

  @media (max-width: 34rem) {
    .rank-row {
      grid-template-columns: 2.25rem 1fr;
    }

    .rank-count {
      grid-column: 2;
    }
  }
</style>
