---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasteWindow from '../components/PasteWindow.astro';
import { getCollection } from 'astro:content';
import { SITE, formatDate, isoDate, cleanTags } from '../lib/site';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const paste = projects.find((p) => p.id.startsWith('paste/') && p.id.endsWith('/zh')) ?? projects[0];

const recent = notes.slice(0, 4);
---

<BaseLayout
  lang="zh"
  title={SITE.name.zh}
  description={SITE.description.zh}
  pathname="/"
  bareTitle
>
  <section class="hero">
    <h1 class="hero-title">自留地</h1>
    <p class="hero-sub">
      这里是 {SITE.author} 的自留地。<br />
      种一些算法笔记，养一个叫 Paste 的 macOS 应用，偶尔写点别的。
    </p>
  </section>

  <section class="band" aria-labelledby="paste-heading">
    <h2 id="paste-heading" class="band-heading">项目</h2>
    {
      paste ? (
        <a class="feature" href="/projects/paste/">
          <PasteWindow
            lang="zh"
            title={paste.data.title}
            tagline={paste.data.tagline}
            status={paste.data.status}
            stack={paste.data.stack}
            links={paste.data.links}
          />
        </a>
      ) : (
        <p class="empty">Paste 的项目条目还没写好（<code>src/content/projects/paste/zh.md</code>）。</p>
      )
    }
  </section>

  <section class="band" aria-labelledby="notes-heading">
    <h2 id="notes-heading" class="band-heading">最近笔记</h2>
    {
      recent.length > 0 ? (
        <ol class="note-list">
          {recent.map((n) => {
            const tags = cleanTags(n.data.tags);
            return (
              <li>
                <a href={`/notes/${n.id}/`}>
                  <span class="n-title">{n.data.title}</span>
                  <time class="n-date" datetime={isoDate(n.data.date)}>
                    {formatDate(n.data.date, 'zh')}
                  </time>
                  {n.data.summary && <span class="n-summary">{n.data.summary}</span>}
                  {tags.length > 0 && <span class="n-tags">{tags.join(' / ')}</span>}
                </a>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="empty">还没有笔记。</p>
      )
    }
    <p class="more"><a href="/notes/">全部 {notes.length} 篇笔记</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 3.5rem 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .hero-title {
    font-size: var(--step-3);
    margin: 0 0 0.75rem;
  }

  .hero-sub {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.8;
    max-width: 26em;
    color: var(--ink-muted);
  }

  .band {
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .band:last-of-type {
    border-bottom: 0;
  }

  .band-heading {
    font-size: var(--step--1);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.06em;
    margin: 0 0 1.25rem;
    color: var(--ink-faint);
  }

  .feature {
    display: block;
    text-decoration: none;
    max-width: 34rem;
  }

  .feature:hover {
    color: inherit;
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .note-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    text-decoration: none;
    align-items: baseline;
  }

  .n-title {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .note-list a:hover .n-title {
    color: var(--seal);
  }

  .n-date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .n-summary {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .n-tags {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .more {
    margin: 1.75rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .empty {
    color: var(--ink-faint);
  }

  @media (max-width: 34rem) {
    .note-list a {
      grid-template-columns: 1fr;
    }

    .n-date {
      order: -1;
    }
  }
</style>
