---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE, formatDate, cleanTags } from '../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf(),
);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const paste = projects.find((p) => p.id.startsWith('paste/') && p.id.endsWith('/zh')) ?? projects[0];

const recent = notes.slice(0, 4);

/* Chips are links in the card meta row, but the site ships no per-tag routes
   (`/tags/*` all redirect to the notes index), so every chip points there. */
const tagChips = (tags?: string[]) =>
  cleanTags(tags).map((label) => ({ label, href: '/notes/' }));

const LINK_LABELS = { repo: '源码仓库', release: '下载', demo: '在线演示' } as const;
type ProjectLinks = { repo?: string; release?: string; demo?: string };
const projectLinks = (links: ProjectLinks) =>
  (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
    .filter((k) => links[k])
    .map((k) => ({ label: LINK_LABELS[k], href: links[k] as string }));

const pasteLinks = paste ? projectLinks(paste.data.links) : [];
---

<BaseLayout
  lang="zh"
  title={SITE.name.zh}
  description={SITE.description.zh}
  pathname="/"
  bareTitle
>
  <div class="container">
    <header class="hero">
      <h1 class="hero-title">Hi，我是 {SITE.author}</h1>
      <p class="hero-tagline">{SITE.description.zh}</p>
    </header>

    <section class="section" aria-labelledby="notes-heading">
      <h2 id="notes-heading" class="band-heading">文章</h2>
      {
        recent.length > 0 ? (
          <div class="card-stack">
            {recent.map((n) => (
              <PostCard
                title={n.data.title}
                href={`/notes/${n.id}/`}
                summary={n.data.summary}
                date={formatDate(asDate(n.data.date), 'zh')}
                tags={tagChips(n.data.tags)}
              />
            ))}
          </div>
        ) : (
          <p class="empty">还没有笔记。</p>
        )
      }
      <p class="more">
        <a href="/notes/">全部 {notes.length} 篇笔记</a>
      </p>
    </section>

    <section class="section" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="band-heading">项目</h2>
      {
        paste ? (
          <div class="project-grid">
            <div class="project-item">
              <PostCard
                title={paste.data.title}
                href={`/projects/${paste.id.split('/')[0]}/`}
                summary={paste.data.tagline}
                date={formatDate(asDate(paste.data.date), 'zh')}
                category={paste.data.status}
              />
              {pasteLinks.length > 0 && (
                <p class="project-links">
                  {pasteLinks.map((l) => (
                    <a href={l.href} rel="noreferrer">
                      {l.label}
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        ) : (
          <p class="empty">
            Paste 的项目条目还没写好（<code>src/content/projects/paste/zh.md</code>）。
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .hero {
    padding-block: 28px;
  }

  .hero-title {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .hero-tagline {
    margin: 0;
    max-width: 40em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .band-heading {
    margin: 0 0 20px;
    font-size: 24px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.01em;
  }

  .project-item {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .project-links a {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .more {
    margin: 20px 0 0;
    font-size: 14px;
  }

  .empty {
    margin: 0;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 60px;
      line-height: 60px;
    }
  }
</style>
