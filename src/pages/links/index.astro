---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
---

<BaseLayout
  lang="zh"
  title="友链"
  description="自留地的友情链接。"
  pathname="/links/"
>
  <div class="container">
    <article class="prose">
      <header class="page-head">
        <h1>友链</h1>
      </header>

      <p>
        想放一些常读的博客和朋友的主页...
      </p>

      <h2>想交换友链</h2>

      <p>
        欢迎联系我！
      </p>

      <ul>
        <li>邮箱：<a href={`mailto:${SITE.email}?subject=友链`}>{SITE.email}</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>

