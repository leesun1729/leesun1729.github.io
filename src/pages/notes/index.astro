---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate, cleanTags } from '../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf(),
);

/* Every tag on the site, built from real data so an empty or whitespace-only
   tag never becomes a filter. */
const tagMap = new Map<string, number>();
for (const n of notes) {
  for (const t of cleanTags(n.data.tags)) tagMap.set(t, (tagMap.get(t) ?? 0) + 1);
}
const tags = [...tagMap.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);

const total = notes.length;

/* The site ships no per-tag routes — `/tags/*` all redirect to this index. */
const tagChips = (t: string[]) => t.map((label) => ({ label, href: '/notes/' }));
---

<BaseLayout
  lang="zh"
  title="笔记"
  description="算法与 C++ 学习笔记：珂朵莉树、SCC、字典树、运算符重载等。"
  pathname="/notes/"
>
  <div class="container">
    <header class="page-head">
      <h1>笔记</h1>
      <p class="lede">
        算法竞赛与 C++ 的学习笔记，最初写于 2024 年。按时间倒序排列。
      </p>
      <p class="page-meta">
        {total} 篇 · {tags.length} 个标签
        {tags.length > 0 && <span class="tag-line">{tags.map(([t]) => t).join(' / ')}</span>}
      </p>
    </header>

    {
      notes.length > 0 ? (
        <div class="card-stack">
          {notes.map((n) => (
            <PostCard
              title={n.data.title}
              href={`/notes/${n.id}/`}
              summary={n.data.summary}
              date={formatDate(asDate(n.data.date), 'zh')}
              tags={tagChips(cleanTags(n.data.tags))}
            />
          ))}
        </div>
      ) : (
        <p class="empty">还没有笔记。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .page-head {
    padding-block: 28px;
  }

  .page-head h1 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 0 0 12px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .page-meta {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .tag-line {
    display: block;
    margin-top: 4px;
    color: var(--muted, #525252);
  }

  .empty {
    margin: 0;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .page-head h1 {
      font-size: 48px;
    }
  }
</style>
