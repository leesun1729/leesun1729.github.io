---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PasteWindow from '../../components/PasteWindow.astro';
import { getCollection } from 'astro:content';
import { formatDate, isoDate } from '../../lib/site';

const all = await getCollection('projects');
const projects = all
  .filter((p) => p.id.endsWith('/zh'))
  .sort((a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  lang="zh"
  title="项目"
  description="leesun 写的软件项目。目前只有一个：Paste，一个原生 macOS 剪切板管理器。"
  pathname="/projects/"
>
  <div class="sheet">
    <aside class="rail">
      <ol>
        <li>{projects.length} 个项目</li>
      </ol>
    </aside>

    <div>
      <header class="page-head">
        <h1>项目</h1>
        <p class="lede">自己写的、还在维护的东西。数量不多，都尽量做完整。</p>
      </header>

      {
        projects.length > 0 ? (
          <ul class="project-list">
            {projects.map((p) => (
              <li>
                <a class="project-card" href={`/projects/${p.id.split('/')[0]}/`}>
                  <PasteWindow
                    lang="zh"
                    title={p.data.title}
                    tagline={p.data.tagline}
                    status={p.data.status}
                    stack={p.data.stack}
                    links={p.data.links}
                  />
                  <p class="project-meta">
                    <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date, 'zh')}</time>
                    {p.data.status && <span>{p.data.status}</span>}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">还没有项目。</p>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .page-head h1 {
    margin-bottom: 0.5rem;
  }

  .lede {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 30em;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
  }

  .project-meta {
    margin: 0.85rem 0 0;
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .empty {
    color: var(--ink-faint);
  }
</style>
