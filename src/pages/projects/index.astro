---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

const all = await getCollection('projects');
const projects = all
  .filter((p) => p.id.endsWith('/zh'))
  .sort(
    (a, b) => a.data.order - b.data.order || asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf(),
  );

const LINK_LABELS = { repo: '源码仓库', release: '下载', demo: '在线演示' } as const;
type ProjectLinks = { repo?: string; release?: string; demo?: string };
const projectLinks = (links: ProjectLinks) =>
  (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
    .filter((k) => links[k])
    .map((k) => ({ label: LINK_LABELS[k], href: links[k] as string }));
---

<BaseLayout
  lang="zh"
  title="项目"
  description="leesun 写的软件项目。目前只有一个：Paste，一个原生 macOS 剪切板管理器。"
  pathname="/projects/"
>
  <div class="container">
    <header class="page-head">
      <h1>项目</h1>
      <p class="lede"> vibcoding </p>
      <p class="page-meta">{projects.length} 个项目</p>
    </header>

    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((p) => {
            const links = projectLinks(p.data.links);
            return (
              <div class="project-item">
                <PostCard
                  title={p.data.title}
                  href={`/projects/${p.id.split('/')[0]}/`}
                  summary={p.data.tagline}
                  date={formatDate(asDate(p.data.date), 'zh')}
                  category={p.data.status}
                />
                {links.length > 0 && (
                  <p class="project-links">
                    {links.map((l) => (
                      <a class="link-dashed" href={l.href} rel="noreferrer">
                        {l.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            );
          })}
        </div>
      ) : (
        <p class="empty">还没有项目。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Page-local layout only. .page-head / .page-head h1 / .lede / .page-meta /
     .empty / .container are defined once in global.css (R4 contract §3.2);
     a local copy would outrank them through [data-astro-cid-*]. */

  .project-item {
    display: grid;
    align-content: start;
    gap: 12px;
  }

</style>
