---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate, cleanTags } from '../../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf(),
);

const tagSet = new Set<string>();
for (const n of notes) for (const t of cleanTags(n.data.tags)) tagSet.add(t);
const tags = [...tagSet].sort((a, b) => a.localeCompare(b, 'zh'));

/* Note detail pages exist in Chinese only, so both the card link and every
   chip point at the Chinese original. */
const tagChips = (t: string[]) => t.map((label) => ({ label, href: '/en/notes/' }));
---

<BaseLayout
  lang="en"
  title="Notes"
  description="Algorithm and C++ notes, written in Chinese."
  pathname="/en/notes/"
>
  <div class="container">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="lede">
        Algorithm and C++ notes from 2024. They are written in Chinese — the detail pages
        exist in Chinese only, so every title below links to the original.
      </p>
      <p class="page-meta">
        {notes.length} notes · {tags.length} tags
        {tags.length > 0 && <span class="tag-line">{tags.join(' / ')}</span>}
      </p>
    </header>

    {
      notes.length > 0 ? (
        <div class="card-stack">
          {notes.map((n) => (
            <PostCard
              title={n.data.title}
              href={`/notes/${n.id}/`}
              summary={n.data.summary}
              date={formatDate(asDate(n.data.date), 'en')}
              tags={tagChips(cleanTags(n.data.tags))}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No notes yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .page-head {
    padding-block: 28px;
  }

  .page-head h1 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 0 0 12px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .page-meta {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .tag-line {
    display: block;
    margin-top: 4px;
    color: var(--muted, #525252);
  }

  .empty {
    margin: 0;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .page-head h1 {
      font-size: 48px;
    }
  }
</style>
