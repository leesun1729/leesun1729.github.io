---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES, categoryLabel, formatDate, cleanTags } from '../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

/* Articles live as `<slug>/en.md`; this is the English home, so only the /en
   half is listed and the URL slug is the directory name. */
const slugOf = (id: string) => id.split('/')[0];

const notes = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((a) => a.id.endsWith('/en'))
  .sort((a, b) => asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf());

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const paste =
  projects.find((p) => p.id.startsWith('paste/') && p.id.endsWith('/en')) ??
  projects.find((p) => p.id.startsWith('paste/'));

const recent = notes.slice(0, 6);

/* Tag chips point at real per-tag pages (/en/tags/<tag>/): click a tag and
   see the articles carrying it. */
const tagChips = (tags?: string[]) =>
  cleanTags(tags).map((label) => ({ label: label, href: `/en/tags/${encodeURIComponent(label)}/` }));

/* The browse row under the article band: every category and every tag that
   actually has articles. Built from the whole collection, not just `recent`. */
const tagCount = new Map<string, number>();
for (const n of notes) for (const t of cleanTags(n.data.tags)) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const allTags = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);
const catsWithNotes = CATEGORIES.filter((c) => notes.some((n) => n.data.category === c.key));

const LINK_LABELS = { repo: 'Source', release: 'Download', demo: 'Demo' } as const;
type ProjectLinks = { repo?: string; release?: string; demo?: string };
const projectLinks = (links: ProjectLinks) =>
  (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
    .filter((k) => links[k])
    .map((k) => ({ label: LINK_LABELS[k], href: links[k] as string }));

const pasteLinks = paste ? projectLinks(paste.data.links) : [];
---

<BaseLayout
  lang="en"
  title={SITE.name.en}
  description={SITE.description.en}
  pathname="/en/"
  bareTitle
>
  <div class="container">
    <header class="hero">
      <div class="hero-split">
        <div>
          <h1 class="hero-title">Hi, {SITE.author}!</h1>
          <p class="hero-tagline">{SITE.description.en}</p>

          <!-- Social icons: inline SVG in currentColor, so they inherit the gray
               ramp and follow the theme. To add one, add an <li> here. -->
          <ul class="social-row" aria-label="Contact">
            <li>
              <a href={SITE.github} rel="me noreferrer" aria-label="GitHub">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  ></path>
                </svg>
              </a>
            </li>
            <li>
              <a href={`mailto:${SITE.email}`} aria-label="Email">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="1.5" y="3" width="13" height="10" rx="1.5"></rect>
                  <path d="m2 4.5 6 4.5 6-4.5"></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <!-- Portrait: uses public/favicons/favicon-512x512.png. -->
        <img
          class="hero-portrait"
          src="/images/000/IMG_5416.jpg"
          alt="leesun's whale avatar"
          width="280"
          height="280"
          loading="eager"
          decoding="async"
        />
      </div>
    </header>

    <section class="section section--divided" aria-labelledby="articles-heading">
      <a class="band-heading" href="#articles-list">Articles</a>
      <h2 id="articles-heading" class="section-title">Articles</h2>

      <div class="browse-row">
        <span class="browse-label">Categories:</span>
        <span class="browse-items">
          {catsWithNotes.map((c, i) => (
            <>
              {i > 0 && <span class="browse-sep" aria-hidden="true"> · </span>}
              <a class="browse-link" href={`/en/articles/category/${c.key}/`}>
                {categoryLabel(c.key, 'en')} ({notes.filter((n) => n.data.category === c.key).length})
              </a>
            </>
          ))}
        </span>
      </div>

      <div class="browse-row">
        <span class="browse-label">Tags:</span>
        <span class="browse-items">
          {allTags.map(([t, n], i) => (
            <>
              {i > 0 && <span class="browse-sep" aria-hidden="true"> · </span>}
              <a class="browse-link" href={`/en/tags/${encodeURIComponent(t)}/`}>
                #{t} ({n})
              </a>
            </>
          ))}
        </span>
      </div>

      <div id="articles-list">
        {
          recent.length > 0 ? (
            <div class="card-stack">
              {recent.map((n) => (
                <PostCard
                  title={n.data.title}
                  href={`/en/articles/${slugOf(n.id)}/`}
                  summary={n.data.summary}
                  date={formatDate(asDate(n.data.date), 'en')}
                  category={n.data.category ? categoryLabel(n.data.category, 'en') : undefined}
                  categoryHref={n.data.category ? `/en/articles/category/${n.data.category}/` : undefined}
                  tags={tagChips(n.data.tags)}
                  cover={n.data.cover}
                />
              ))}
            </div>
          ) : (
            <p class="empty">No articles yet.</p>
          )
        }
        <p class="more">
          <a href="/en/articles/">All {notes.length} articles</a>
        </p>
      </div>
    </section>

    <section class="section section--divided" aria-labelledby="projects-heading">
      <a class="band-heading" href="#projects-list">Projects</a>
      <h2 id="projects-heading" class="section-title">Projects</h2>

      <div id="projects-list">
      {
        paste ? (
          <div class="card-stack">
            <div class="project-item">
              <PostCard
                title={paste.data.title}
                href={`/en/projects/${paste.id.split('/')[0]}/`}
                summary={paste.data.tagline}
                date={formatDate(asDate(paste.data.date), 'en')}
                category={paste.data.status}
              />
              {pasteLinks.length > 0 && (
                <p class="project-links">
                  {pasteLinks.map((l) => (
                    <a class="link-dashed" href={l.href} rel="noreferrer">
                      {l.label}
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        ) : (
          <p class="empty">The Paste project entry is not written yet.</p>
        )
      }
      <p class="more">
        <a href="/en/projects/">All projects</a>
      </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Page-local layout only. .hero / .hero-title / .hero-tagline / .band-heading /
     .more / .empty / .container have their single definition in global.css
     (R4 contract §3.2) — a local copy would carry [data-astro-cid-*] and win
     the cascade, silently reverting the global refinement. */

  .project-item {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  /* Browse rows under the section title: "Categories: A (1) · B (2)" as a
     running text line, not chips — the reference's filter rows. Gray ink,
     darker on hover, counts in the same voice as the label. */
  /* The filter rows sit tight under the section title, then a clear gap
     separates them from the first card. Without the bottom margin the list
     ran straight into the rows and the block read as one dense paragraph. */
  .browse-row {
    margin: 0.25rem 0 0;
    font-size: var(--step--1);
    line-height: 1.9;
    color: var(--muted);
  }

  .browse-row + .browse-row {
    margin-top: 0.35rem;
  }

  /* The list starts well below the last filter row. */
  #articles-list,
  #projects-list {
    margin-top: 2.5rem;
  }

  .browse-label {
    font-weight: 700;
    color: var(--meta);
  }

  .browse-sep {
    color: var(--line-strong);
  }

  .browse-link {
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  .browse-link:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

</style>
