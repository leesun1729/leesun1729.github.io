---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../../lib/site';

const asDate = (d: Date | string) => (d instanceof Date ? d : new Date(d));

const all = await getCollection('projects');
const projects = all
  .filter((p) => p.id.endsWith('/en'))
  .sort(
    (a, b) => a.data.order - b.data.order || asDate(b.data.date).valueOf() - asDate(a.data.date).valueOf(),
  );

const LINK_LABELS = { repo: 'Source', release: 'Download', demo: 'Demo' } as const;
type ProjectLinks = { repo?: string; release?: string; demo?: string };
const projectLinks = (links: ProjectLinks) =>
  (Object.keys(LINK_LABELS) as (keyof typeof LINK_LABELS)[])
    .filter((k) => links[k])
    .map((k) => ({ label: LINK_LABELS[k], href: links[k] as string }));
---

<BaseLayout
  lang="en"
  title="Projects"
  description="Software by leesun. Currently one: Paste, a native macOS clipboard manager."
  pathname="/en/projects/"
>
  <div class="container">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lede">Things I build and still maintain. There are few of them, so each one gets finished.</p>
      <p class="page-meta">
        {projects.length} project{projects.length === 1 ? '' : 's'}
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((p) => {
            const links = projectLinks(p.data.links);
            return (
              <div class="project-item">
                <PostCard
                  title={p.data.title}
                  href={`/en/projects/${p.id.split('/')[0]}/`}
                  summary={p.data.tagline}
                  date={formatDate(asDate(p.data.date), 'en')}
                  category={p.data.status}
                />
                {links.length > 0 && (
                  <p class="project-links">
                    {links.map((l) => (
                      <a href={l.href} rel="noreferrer">
                        {l.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            );
          })}
        </div>
      ) : (
        <p class="empty">No projects yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .page-head {
    padding-block: 28px;
  }

  .page-head h1 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 0 0 12px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .page-meta {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .project-item {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .project-links a {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .empty {
    margin: 0;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .page-head h1 {
      font-size: 48px;
    }
  }
</style>
