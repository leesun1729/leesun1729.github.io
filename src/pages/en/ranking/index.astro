---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadRanking, labelFor, share } from '../../../lib/ranking';
import { formatDate } from '../../../lib/site';

const { entries, generatedAt, source, site } = loadRanking();
const max = entries.reduce((m, e) => Math.max(m, e.count), 0);
const hasData = entries.length > 0;
---

<BaseLayout
  lang="en"
  title="Ranking"
  description="Most-viewed pages on this site, counted by GoatCounter."
  pathname="/en/ranking/"
>
  <div class="container">
    <header class="page-head">
      <h1>Ranking</h1>
      <p class="lede">Pages ordered by view count, counted by GoatCounter.</p>
      <p class="page-meta">
        {hasData ? `${entries.length} pages` : 'no data yet'}
        {source && <span class="sep"> · </span>}
        {source && <span>{source}</span>}
        {generatedAt && <span class="sep"> · </span>}
        {generatedAt && (
          <time datetime={generatedAt.slice(0, 10)}>{formatDate(new Date(generatedAt), 'en')}</time>
        )}
      </p>
    </header>

    {
      hasData ? (
        <ol class="rank-list">
          {entries.map((e, i) => (
            <li class="rank-row">
              <span class="rank-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="rank-body">
                <a
                  class="link-dashed"
                  href={e.path}
                  hreflang={e.path.startsWith('/articles/') ? 'zh-CN' : undefined}
                >
                  {labelFor(e)}
                </a>
                <span class="rank-bar" aria-hidden="true">
                  <span style={`width:${(share(e.count, max) * 100).toFixed(1)}%`} />
                </span>
              </span>
              <span class="rank-count">{e.count.toLocaleString('en-US')}</span>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state prose">
          <p class="empty-title">No data yet.</p>
          <p>
            This page is filled by <code>scripts/fetch-ranking.mjs</code>, which pulls counts from
            GoatCounter into <code>src/data/ranking.json</code>. That file currently ships with an
            empty <code>entries</code> array, meaning no fetch has succeeded yet — usually because
            <code>GOATCOUNTER_SITE</code> or <code>GOATCOUNTER_TOKEN</code> is not configured.
          </p>
          <p>
            In the meantime, the <a href="/en/articles/">articles</a> and
            <a href="/en/projects/">projects</a> are the place to start.
          </p>
          {site && (
            <p class="empty-meta">
              Source: <a href={site} rel="noreferrer">{site}</a>
            </p>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Page-local layout only. .page-head / .page-head h1 / .lede / .page-meta /
     .container are defined once in global.css (R4 contract §3.2); a local copy
     would outrank them through [data-astro-cid-*]. */

  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .rank-row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px dashed var(--line);
  }

  .rank-num {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .rank-body {
    min-width: 0;
  }

  .rank-bar {
    display: block;
    height: 2px;
    background: var(--line);
    margin-top: 8px;
  }

  .rank-bar > span {
    display: block;
    height: 100%;
    background: var(--fg);
  }

  .rank-count {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  /* Same language as .card: 1px dashed var(--line), 1rem radius, 20px/24px pad. */
  .empty-state {
    max-width: 40em;
    padding: 20px 24px;
    border: 1px dashed var(--line);
    border-radius: 1rem;
  }

  .empty-title {
    margin-top: 0;
    font-weight: 700;
    text-indent: 0;
  }

  .empty-state p {
    text-indent: 0;
  }

  .empty-state p:last-child {
    margin-bottom: 0;
  }

  .empty-meta {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .rank-row {
      grid-template-columns: 2.25rem 1fr;
    }

    .rank-count {
      grid-column: 2;
    }
  }
</style>
