---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadRanking, labelFor, share } from '../../../lib/ranking';
import { formatDate } from '../../../lib/site';

const { entries, generatedAt, source, site } = loadRanking();
const max = entries.reduce((m, e) => Math.max(m, e.count), 0);
const hasData = entries.length > 0;
---

<BaseLayout
  lang="en"
  title="Ranking"
  description="Most-viewed pages on this site, counted by GoatCounter."
  pathname="/en/ranking/"
>
  <div class="container">
    <header class="page-head">
      <h1>Ranking</h1>
      <p class="lede">Pages ordered by view count, counted by GoatCounter. No personal tracking.</p>
      <p class="page-meta">
        {hasData ? `${entries.length} pages` : 'no data yet'}
        {source && <span class="sep"> · </span>}
        {source && <span>{source}</span>}
        {generatedAt && <span class="sep"> · </span>}
        {generatedAt && (
          <time datetime={generatedAt.slice(0, 10)}>{formatDate(new Date(generatedAt), 'en')}</time>
        )}
      </p>
    </header>

    {
      hasData ? (
        <ol class="rank-list">
          {entries.map((e, i) => (
            <li class="rank-row">
              <span class="rank-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="rank-body">
                <a
                  class="rank-link"
                  href={e.path}
                  hreflang={e.path.startsWith('/notes/') ? 'zh-CN' : undefined}
                >
                  {labelFor(e)}
                </a>
                <span class="rank-bar" aria-hidden="true">
                  <span style={`width:${(share(e.count, max) * 100).toFixed(1)}%`} />
                </span>
              </span>
              <span class="rank-count">{e.count.toLocaleString('en-US')}</span>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state prose">
          <p class="empty-title">No data yet.</p>
          <p>
            This page is filled by <code>scripts/fetch-ranking.mjs</code>, which pulls counts from
            GoatCounter into <code>src/data/ranking.json</code>. That file currently ships with an
            empty <code>entries</code> array, meaning no fetch has succeeded yet — usually because
            <code>GOATCOUNTER_SITE</code> or <code>GOATCOUNTER_TOKEN</code> is not configured.
          </p>
          <p>
            In the meantime, the <a href="/en/notes/">notes</a> and
            <a href="/en/projects/">projects</a> are the place to start.
          </p>
          {site && (
            <p class="empty-meta">
              Source: <a href={site} rel="noreferrer">{site}</a>
            </p>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /* global.css ships .wrap (896px, centered) and BaseLayout applies it to
     <main>. The promised .container utility was not implemented there, so
     pages that need it define it locally rather than editing global.css. */

  .page-head {
    padding-block: 28px;
  }

  .page-head h1 {
    margin: 0 0 12px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lede {
    margin: 0 0 12px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted, #525252);
    text-wrap: pretty;
  }

  .page-meta {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--meta, #262626);
  }

  .rank-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .rank-row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px dashed var(--line, #d4d4d4);
  }

  .rank-num {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted, #525252);
    font-variant-numeric: tabular-nums;
  }

  .rank-body {
    min-width: 0;
  }

  .rank-link {
    text-decoration: none;
  }

  .rank-bar {
    display: block;
    height: 2px;
    background: var(--line, #d4d4d4);
    margin-top: 8px;
  }

  .rank-bar > span {
    display: block;
    height: 100%;
    background: var(--fg, #000);
  }

  .rank-count {
    font-size: 12px;
    font-weight: 500;
    color: var(--meta, #262626);
    font-variant-numeric: tabular-nums;
  }

  .empty-state {
    max-width: 40em;
    padding: 20px 24px;
    border: 1px dashed var(--line, #d4d4d4);
    border-radius: 1rem;
  }

  .empty-title {
    margin-top: 0;
    font-weight: 700;
    text-indent: 0;
  }

  .empty-state p {
    text-indent: 0;
  }

  .empty-state p:last-child {
    margin-bottom: 0;
  }

  .empty-meta {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted, #525252);
  }

  @media (min-width: 768px) {
    .page-head h1 {
      font-size: 48px;
    }
  }

  @media (max-width: 34rem) {
    .rank-row {
      grid-template-columns: 2.25rem 1fr;
    }

    .rank-count {
      grid-column: 2;
    }
  }
</style>
