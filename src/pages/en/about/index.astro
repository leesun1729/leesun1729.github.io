---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ANIME, animePoster } from '../../../lib/anime';
import { SITE } from '../../../lib/site';

/* Self-introduction: one trait per line, short fragments (the reference's style). */
const traits = [
  "Pursuing a master's degree",
  'Based in China',
  'Into Honor of Kings and Chinese animation',
  'Loves travelling and trying new things',
];

/* TOC entries map 1:1 onto the page's h2 ids — keep both sides in sync. */
const sections = [
  { id: 'footprints', label: 'Footprints' },
  { id: 'anime', label: 'Anime' },
  { id: 'contact', label: 'Contact' },
];

/* Platform label + the real link, sourced from src/lib/site.ts. No invented accounts. */
const contacts = [
  { label: 'Email', href: `mailto:${SITE.email}`, text: SITE.email, external: false },
  { label: 'GitHub', href: SITE.github, text: 'github.com/leesun1729', external: true },
];

/* The list and its poster lookup live in src/lib/anime.ts, shared with the
   Chinese page so the two can never drift apart. */
---

<BaseLayout
  lang="en"
  title="About"
  description="About leesun: a short self-introduction, footprints, anime and contact links."
  pathname="/en/about/"
>
  <div class="container">
    <header class="page-head">
      <h1>About</h1>
    </header>

    <details class="toc">
      <summary>
        <span class="toc-title">Contents</span>
        <span class="toc-hint" aria-hidden="true">
          <span class="hint-expand">Expand</span>
          <span class="hint-collapse">Collapse</span>
        </span>
      </summary>
      <nav class="toc-nav" aria-label="Contents">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a class="link-dashed" href={`#${s.id}`}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <article class="prose">
      <ul class="traits">
        {traits.map((t) => <li>{t}</li>)}
      </ul>

      <h2 id="footprints">Footprints</h2>

      <iframe
        class="vagula-map"
        src="/VagulaMap/index.html"
        title="Travel footprint map"
        loading="lazy"
        allowfullscreen
      ></iframe>

      <h2 id="anime">Anime</h2>

      <p>I watch a bit of everything, mostly Chinese animation. The list will fill in.</p>

      <!-- Only entries that have a poster are rendered: drop an image named
           after the show into public/images/anime/ (e.g. 剑来.jpg) and rebuild. -->
      <ul class="anime-grid" aria-label="Chinese animation list">
        {
          ANIME.map((a) => ({ a, poster: animePoster(a) }))
            .filter((x) => x.poster)
            .map(({ a, poster }) => (
              <li class="anime-item">
                <a class="anime-card" href={a.href} rel="noreferrer" target="_blank">
                  <img
                    class="anime-poster"
                    src={poster}
                    alt={`${a.title} poster`}
                    width="300"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="anime-meta">
                    <span class="anime-title">{a.title}</span>
                    <span class="anime-sub">
                      {a.year} · {a.platform}{a.film && ' · Cinema'}
                    </span>
                    <span class="anime-note">{a.note.en}</span>
                  </span>
                </a>
              </li>
            ))
        }
      </ul>

      <h2 id="contact">Contact</h2>

      <ul class="contacts">
        {
          contacts.map((c) => (
            <li>
              <span class="contact-label">{c.label}</span>
              <a href={c.href} rel={c.external ? 'me noreferrer' : undefined}>
                {c.text}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</BaseLayout>

<style>
  /* Page-local blocks only. .container / .page-head are defined once in
     global.css (R4 contract §3.2); a local copy would outrank them through
     [data-astro-cid-*]. */

  /* --- Contents: native <details>, no JS, keyboard reachable ------------- */

  /* Same dashed language as .card / .map / .empty-state: 1px dashed var(--line). */
  .toc {
    border: 1px dashed var(--line);
    border-radius: 1rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .toc > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    color: var(--meta);
    list-style: none;
  }

  .toc > summary::-webkit-details-marker {
    display: none;
  }

  .toc > summary::marker {
    content: '';
  }

  .toc > summary:hover {
    color: var(--fg);
  }

  /* Focus ring: the single global :focus-visible rule (contract §4.4). */

  .toc[open] > summary {
    border-bottom: 1px dashed var(--line);
  }

  .hint-collapse {
    display: none;
  }

  .toc[open] .hint-expand {
    display: none;
  }

  .toc[open] .hint-collapse {
    display: inline;
  }

  .toc-nav {
    padding: 0.7rem 1rem 0.8rem;
  }

  .toc-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  /* The jump links carry the global .link-dashed class (R4 contract §3.3);
     only the colour state stays local. */
  .toc-nav a {
    color: inherit;
  }

  .toc-nav a:hover {
    color: var(--fg);
  }

  /* --- Self-introduction: short fragments, no first-line indent --------- */

  .traits {
    font-size: var(--step-1);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .traits li {
    margin-bottom: 0.15em;
  }

  /* --- Footprints: the owner's VagulaMap, embedded as an iframe --------- */

  .vagula-map {
    display: block;
    width: 100%;
    height: 600px;
    border: 1px dashed var(--line);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg);
  }

  @media (max-width: 40rem) {
    .vagula-map {
      height: 420px;
    }
  }

  /* --- Contact: platform label + real link ------------------------------ */

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contacts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    margin: 0;
    border-bottom: 1px dashed var(--line);
  }

  .contact-label {
    min-width: 5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--meta);
  }

  /* The sticky header is 60px tall; 1.5rem let a jumped-to heading land under
     it. Match the offset the home page's list anchors already use. */
  h2 {
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
</style>
